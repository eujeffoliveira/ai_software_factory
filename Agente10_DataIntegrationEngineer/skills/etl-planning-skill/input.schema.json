{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "etl-planning-skill Input",
  "type": "object",
  "required": ["integration_id", "mapping_id", "estimated_total_records", "source_data_format"],
  "properties": {
    "integration_id": { "type": "string", "pattern": "^INT-[A-Z0-9]+-[0-9]{3}$" },
    "mapping_id": { "type": "string", "pattern": "^MAP-[A-Z0-9]+-[0-9]{3}$" },
    "estimated_total_records": { "type": "integer", "minimum": 1 },
    "source_data_format": { "type": "string", "enum": ["json_api", "csv", "database_export", "xml", "parquet"] },
    "rollback_required": { "type": "boolean", "default": true },
    "has_foreign_key_dependencies": { "type": "boolean", "default": false }
  },
  "additionalProperties": false
}
