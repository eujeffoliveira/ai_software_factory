{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ci-cd-pipeline-skill Output",
  "type": "object",
  "required": ["overall_status", "step_results"],
  "properties": {
    "overall_status": { "type": "string", "enum": ["PASS", "BLOCKED_CI_FAILURE"] },
    "ci_run_id": { "type": "string" },
    "ci_run_url": { "type": "string" },
    "step_results": {
      "type": "object",
      "properties": {
        "typecheck": { "type": "string", "enum": ["PASS", "FAIL", "MISSING"] },
        "lint": { "type": "string", "enum": ["PASS", "FAIL", "MISSING"] },
        "unit_tests": { "type": "string", "enum": ["PASS", "FAIL", "MISSING"] },
        "build": { "type": "string", "enum": ["PASS", "FAIL", "MISSING"] },
        "e2e_tests": { "type": "string", "enum": ["PASS", "FAIL", "MISSING", "NOT_APPLICABLE"] }
      }
    },
    "failing_steps": { "type": "array", "items": { "type": "string" } },
    "gate_6_impact": { "type": "string" }
  }
}
