{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Artifact Contract Validation Skill Input",
  "type": "object",
  "required": ["gate_number", "handoff_package"],
  "properties": {
    "gate_number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 7
    },
    "handoff_package": {
      "type": "object",
      "required": ["artifact_produced", "summary", "assumptions", "open_questions", "risks", "required_next_agent", "validation_checklist"],
      "properties": {
        "artifact_produced": { "type": "string" },
        "summary": { "type": "string" },
        "assumptions": { "type": "array", "items": { "type": "string" } },
        "open_questions": { "type": "array", "items": { "type": "object" } },
        "risks": { "type": "array", "items": { "type": "object" } },
        "required_next_agent": { "type": "string" },
        "validation_checklist": { "type": "array", "items": { "type": "object" } }
      }
    },
    "current_ledger": {
      "type": "object",
      "description": "Current State_Ledger.json for context"
    },
    "revision_context": {
      "type": "string",
      "description": "Previous RETURNED_FOR_REVISION feedback, if this is a re-validation"
    }
  }
}
