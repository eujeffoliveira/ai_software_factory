  "capabilities": {
    "can_interact_with_human": true,
    "can_trigger_council": true,
    "can_create_adr_request": true,
    "can_approve_gates": true,
    "can_block_gates": true,
    "can_route_to_agents": true,
    "can_update_state_ledger": true,
    "can_register_risks": true,
    "can_generate_progress_reports": true,
    "can_execute_code": false,
    "can_deploy": false,
    "can_accept_security_risk_alone": false,
    "can_write_final_code": false,
    "can_replace_product_owner": false,
    "can_replace_architect": false,
    "can_replace_qa": false,
    "can_replace_devsecops": false,
    "can_bypass_gate": false
  },
  "tech_stack_governance": {
    "golden_path": {
      "framework": "Next.js 16",
      "router": "App Router",
      "proxy": "proxy.ts (obrigatório, não middleware.ts)",
      "frontend": "React 19",
      "language": "TypeScript 5",
      "database": "PostgreSQL via Supabase",
      "orm": "Prisma 7 com PrismaPg adapter",
      "migrations": "Prisma Migrate (migrate deploy em staging/produção)",
      "deploy": "Vercel",
      "cron": "Vercel Cron",
      "auth": "NextAuth v5 + Google OAuth",
      "css": "Tailwind CSS v4",
      "validation": "Zod",
      "unit_tests": "Vitest",
      "e2e_tests": "Playwright",
      "charts": "Recharts v3",
      "data_fetching_hierarchy": ["Server Components", "Server Actions", "SWR (apenas polling real)"]
    },
    "mandatory_patterns": [
      "audit_log para ações humanas sensíveis",
      "sync_log para jobs automáticos",
      "logs estruturados em JSON",
      "lib/env.ts para variáveis de ambiente",
      "Zod nas fronteiras do sistema",
      "guardCron() em todas as cron routes",
      "autorização server-side antes de mutações privilegiadas",
      "jobs idempotentes",
      "healthcheck em /api/health",
      "rollback plan antes de deploy em produção",
      "ADR antes de qualquer desvio do Golden Path"
    ],
    "critical_antipatterns": [
      "SQL raw concatenado",
      "lógica de negócio em route.ts",
      "process.env espalhado fora de lib/env.ts",
      "segredo no código",
      "middleware.ts em Next.js 16",
      "prisma db push em staging/produção",
      "job sem idempotência",
      "SWR sem necessidade real",
      "deploy de produção sem rollback plan",
      "stack trace exposto ao cliente",
      "importar biblioteca ausente no package.json"
    ]
  }
}
