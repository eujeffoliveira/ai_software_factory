{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "State Ledger",
  "description": "Global project state maintained by the Tech Lead throughout the software development lifecycle",
  "type": "object",
  "required": ["project_name", "project_id", "current_phase", "current_agent", "next_agent", "approved_artifacts", "next_action"],
  "properties": {
    "project_name": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "project_archetype": {
      "type": "string",
      "enum": ["web_app", "automation_script", "data_pipeline", "api_service", "cli_tool", "mcp_server", "integration_worker", "notebook_analysis", ""]
    },
    "golden_model": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "current_phase": {
      "type": "string",
      "enum": ["requirements", "architecture", "planning", "implementation", "qa", "security", "deploy", "post_deploy", "maintenance", "blocked", "incident"]
    },
    "current_agent": {
      "type": "string",
      "enum": ["Agente00_TechLead", "Agente01_ProductOwner", "Agente02_SoftwareArchitect", "Agente03_SoftwareEngineer", "Agente04_DevBackend", "Agente05_DevFrontend", "Agente06_QaEngineer", "Agente07_DevSecOps", "Agente08_DevOps", "Agente09_UxUiDesigner", "Agente10_DataIntegrationEngineer", "HUMAN", "COUNCIL"]
    },
    "next_agent": {
      "type": "string",
      "enum": ["Agente00_TechLead", "Agente01_ProductOwner", "Agente02_SoftwareArchitect", "Agente03_SoftwareEngineer", "Agente04_DevBackend", "Agente05_DevFrontend", "Agente06_QaEngineer", "Agente07_DevSecOps", "Agente08_DevOps", "Agente09_UxUiDesigner", "Agente10_DataIntegrationEngineer", "HUMAN", "COUNCIL"]
    },
    "approved_artifacts": {
      "type": "object",
      "required": ["prd", "architecture", "api_contract", "db_schema", "execution_plan", "qa", "security", "deployment", "rollback", "post_deploy"],
      "properties": {
        "prd": { "type": "boolean" },
        "architecture": { "type": "boolean" },
        "api_contract": { "type": "boolean" },
        "db_schema": { "type": "boolean" },
        "execution_plan": { "type": "boolean" },
        "qa": { "type": "boolean" },
        "security": { "type": "boolean" },
        "deployment": { "type": "boolean" },
        "rollback": { "type": "boolean" },
        "post_deploy": { "type": "boolean" }
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "question", "source_agent", "blocking"],
        "properties": {
          "id": { "type": "string" },
          "question": { "type": "string", "minLength": 1 },
          "source_agent": { "type": "string" },
          "blocking": { "type": "boolean" },
          "created_at": { "type": "string", "format": "date-time" },
          "resolved_at": { "type": ["string", "null"], "format": "date-time" },
          "resolution": { "type": ["string", "null"] }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "decision", "rationale", "made_by", "date"],
        "properties": {
          "id": { "type": "string" },
          "decision": { "type": "string", "minLength": 1 },
          "rationale": { "type": "string", "minLength": 1 },
          "made_by": { "type": "string" },
          "date": { "type": "string", "format": "date-time" },
          "reversible": { "type": "boolean" }
        }
      }
    },
    "adrs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^ADR-[0-9]{3,}" },
          "title": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["Proposed", "Approved", "Rejected", "Superseded"] },
          "file_path": { "type": "string" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "severity", "phase", "status"],
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string", "minLength": 1 },
          "severity": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
          "phase": { "type": "string" },
          "source_agent": { "type": "string" },
          "mitigation": { "type": "string" },
          "status": { "type": "string", "enum": ["OPEN", "MITIGATED", "ACCEPTED", "ESCALATED", "CLOSED"] },
          "created_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "blocked_tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["description", "blocked_by", "created_at"],
        "properties": {
          "description": { "type": "string", "minLength": 1 },
          "blocked_by": { "type": "string" },
          "resolution_required": { "type": "string" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "human_approvals_required": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "topic", "urgency", "status", "requested_at"],
        "properties": {
          "id": { "type": "string" },
          "topic": { "type": "string", "minLength": 1 },
          "urgency": { "type": "string", "enum": ["CRITICAL", "HIGH", "MEDIUM"] },
          "status": { "type": "string", "enum": ["PENDING", "APPROVED", "REJECTED", "EXPIRED"] },
          "requested_at": { "type": "string", "format": "date-time" },
          "resolved_at": { "type": ["string", "null"], "format": "date-time" },
          "decision": { "type": ["string", "null"] }
        }
      }
    },
    "gate_history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["gate", "status", "decided_at"],
        "properties": {
          "gate": { "type": "integer", "minimum": 1, "maximum": 7 },
          "status": { "type": "string" },
          "decided_at": { "type": "string", "format": "date-time" },
          "notes": { "type": "string" }
        }
      }
    },
    "next_action": { "type": "string", "minLength": 1 },
    "mcp_status": {
      "type": "object",
      "properties": {
        "server_online": { "type": ["boolean", "null"] },
        "last_checked": { "type": ["string", "null"] },
        "documents_indexed": { "type": ["integer", "null"], "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
