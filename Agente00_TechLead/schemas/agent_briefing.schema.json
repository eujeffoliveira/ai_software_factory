{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Briefing",
  "description": "Directed briefing from Tech Lead to a specialist agent",
  "type": "object",
  "required": ["target_agent", "phase", "task", "inputs", "expected_outputs", "constraints", "issued_at"],
  "properties": {
    "target_agent": { "type": "string" },
    "phase": { "type": "string" },
    "task": { "type": "string", "minLength": 20 },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "expected_outputs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string" }
    },
    "open_questions_to_address": {
      "type": "array",
      "items": { "type": "string" }
    },
    "risks_to_consider": {
      "type": "array",
      "items": { "type": "string" }
    },
    "golden_model_reminders": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Specific Golden Model rules relevant to this task"
    },
    "adrs_in_scope": {
      "type": "array",
      "items": { "type": "string" },
      "description": "ADR IDs that this agent must respect"
    },
    "gate_target": {
      "type": "integer",
      "minimum": 1,
      "maximum": 7,
      "description": "Which gate this briefing is working toward"
    },
    "issued_at": { "type": "string", "format": "date-time" },
    "issued_by": { "type": "string", "default": "Agente00_TechLead" }
  },
  "additionalProperties": false
}
