{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Council Verdict",
  "description": "Structured verdict from the Tech Lead Council's five-persona deliberation",
  "type": "object",
  "required": ["topic", "context", "persona_analyses", "consensus", "clashes", "blind_spots", "recommendation", "one_thing_to_do_first", "issued_at"],
  "properties": {
    "topic": { "type": "string", "minLength": 1 },
    "context": { "type": "string", "minLength": 50 },
    "triggered_by_gate": { "type": ["integer", "null"], "minimum": 1, "maximum": 7 },
    "persona_analyses": {
      "type": "object",
      "required": ["contrarian", "first_principles_thinker", "expansionist", "outsider", "executor"],
      "properties": {
        "contrarian": { "type": "string", "minLength": 20 },
        "first_principles_thinker": { "type": "string", "minLength": 20 },
        "expansionist": { "type": "string", "minLength": 20 },
        "outsider": { "type": "string", "minLength": 20 },
        "executor": { "type": "string", "minLength": 20 }
      }
    },
    "consensus": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "description": "Points where all or most personas agree"
    },
    "clashes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["topic", "positions"],
        "properties": {
          "topic": { "type": "string" },
          "positions": { "type": "string" }
        }
      },
      "description": "Points of meaningful disagreement between personas"
    },
    "blind_spots": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "Risks or assumptions that were overlooked in initial analysis"
    },
    "recommendation": { "type": "string", "minLength": 50 },
    "one_thing_to_do_first": { "type": "string", "minLength": 20 },
    "requires_human_decision": { "type": "boolean" },
    "issued_at": { "type": "string", "format": "date-time" },
    "issued_by": { "type": "string", "default": "Agente00_TechLead" }
  },
  "additionalProperties": false
}
