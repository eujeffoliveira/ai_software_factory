{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Handoff Package",
  "description": "Mandatory handoff contract every agent must deliver at the end of their phase",
  "type": "object",
  "required": [
    "artifact_produced",
    "summary",
    "assumptions",
    "open_questions",
    "risks",
    "required_next_agent",
    "validation_checklist"
  ],
  "properties": {
    "artifact_produced": {
      "type": "string",
      "minLength": 1,
      "description": "Name of the primary artifact produced (e.g., PRD.md, Architecture.md)"
    },
    "summary": {
      "type": "string",
      "minLength": 50,
      "description": "Objective summary of what was produced and why"
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Assumptions made during this phase that require validation"
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["question", "impact", "blocking"],
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1
          },
          "impact": {
            "type": "string",
            "minLength": 1
          },
          "blocking": {
            "type": "boolean"
          }
        }
      },
      "description": "Unresolved questions that may impact the next phase"
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["description", "severity", "mitigation"],
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
          },
          "mitigation": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "description": "Risks identified during this phase"
    },
    "required_next_agent": {
      "type": "string",
      "enum": [
        "Agente00_TechLead",
        "Agente01_ProductOwner",
        "Agente02_SoftwareArchitect",
        "Agente03_SoftwareEngineer",
        "Agente04_DevBackend",
        "Agente05_DevFrontend",
        "Agente06_QaEngineer",
        "Agente07_DevSecOps",
        "Agente08_DevOps",
        "Agente09_UxUiDesigner",
        "Agente10_DataIntegrationEngineer",
        "HUMAN",
        "COUNCIL"
      ],
      "description": "The agent or entity that should act next"
    },
    "validation_checklist": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["item", "status"],
        "properties": {
          "item": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": ["DONE", "PENDING", "NOT_APPLICABLE"]
          },
          "note": {
            "type": "string"
          }
        }
      },
      "description": "Checklist items validating the completeness of this handoff"
    },
    "adr_created": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs of ADRs created during this phase (e.g., ADR-001)"
    },
    "gate_status": {
      "type": "string",
      "description": "Gate status if this is a gate-producing handoff"
    },
    "produced_by": {
      "type": "string",
      "description": "Agent ID that produced this handoff"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of when this handoff was created"
    }
  },
  "additionalProperties": false
}
