{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-software-factory/schemas/agente11-exploratory-analysis-report",
  "title": "Exploratory Analysis Report",
  "type": "object",
  "required": ["dataset_context", "data_quality_summary", "findings", "eda_conclusion"],
  "properties": {
    "dataset_context": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "grain", "period_covered"],
        "properties": {
          "source": { "type": "string" },
          "grain": { "type": "string" },
          "rows": { "type": "integer", "minimum": 0 },
          "period_covered": { "type": "string" },
          "refresh_cadence": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "data_quality_summary": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["check", "status"],
        "properties": {
          "check": { "type": "string" },
          "status": { "type": "string", "enum": ["pass", "caveat", "block", "not_evaluated"] },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding_id", "observation", "confidence"],
        "properties": {
          "finding_id": { "type": "string", "pattern": "^FIND-[0-9]{3,}$" },
          "metric_or_source": { "type": "string" },
          "segment": { "type": "string" },
          "observation": { "type": "string" },
          "confidence": { "type": "string", "enum": ["high", "medium", "low", "insufficient_evidence"] }
        },
        "additionalProperties": false
      }
    },
    "eda_conclusion": { "type": "string", "enum": ["ready", "ready_with_caveats", "blocked"] }
  },
  "additionalProperties": false
}
