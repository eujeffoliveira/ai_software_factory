{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-software-factory/schemas/agente11-insight-report",
  "title": "Insight Report",
  "type": "object",
  "required": ["executive_summary", "findings", "recommended_actions", "open_questions", "risks"],
  "properties": {
    "executive_summary": { "type": "string" },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["finding_id", "finding", "evidence", "confidence", "recommendation"],
        "properties": {
          "finding_id": { "type": "string", "pattern": "^FIND-[0-9]{3,}$" },
          "finding": { "type": "string" },
          "evidence": { "type": "array", "items": { "type": "string" } },
          "metric_refs": { "type": "array", "items": { "type": "string", "pattern": "^MET-[0-9]{3,}$" } },
          "confidence": { "type": "string", "enum": ["high", "medium", "low", "insufficient_evidence"] },
          "caveats": { "type": "array", "items": { "type": "string" } },
          "recommendation": { "type": "string" },
          "owner": { "type": "string" },
          "validation_step": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "recommended_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action", "owner", "validation_metric", "priority"],
        "properties": {
          "action": { "type": "string" },
          "owner": { "type": "string" },
          "validation_metric": { "type": "string" },
          "priority": { "type": "string", "enum": ["low", "medium", "high"] }
        },
        "additionalProperties": false
      }
    },
    "open_questions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["risk_id", "classification", "description", "mitigation"],
        "properties": {
          "risk_id": { "type": "string", "pattern": "^RISK-[0-9]{3,}$" },
          "classification": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
          "description": { "type": "string" },
          "mitigation": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
