{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-software-factory/schemas/agente11-handoff",
  "title": "Agente11_DataAnalyst Handoff Package",
  "description": "Schema for the Analysis Handoff Package produced by Agente11_DataAnalyst after Analysis Review.",
  "type": "object",
  "required": [
    "handoff_id",
    "produced_by",
    "produced_at",
    "gate_decision",
    "gate_status_code",
    "artifact_set",
    "analysis_question",
    "metrics_covered",
    "findings",
    "confidence_summary",
    "data_quality_status",
    "privacy_notes",
    "blocking_issues",
    "open_questions",
    "risks",
    "required_next_agent",
    "gate_ready"
  ],
  "properties": {
    "handoff_id": {
      "type": "string",
      "pattern": "^HANDOFF-A11-[0-9]{8}-[0-9]{4}$"
    },
    "produced_by": {
      "type": "string",
      "const": "Agente11_DataAnalyst"
    },
    "produced_at": {
      "type": "string",
      "format": "date-time"
    },
    "gate_decision": {
      "type": "string",
      "enum": ["APPROVED", "APPROVED_WITH_CONDITIONS", "BLOCKED", "RETURNED"]
    },
    "gate_status_code": {
      "type": "string",
      "enum": [
        "APPROVED",
        "APPROVED_WITH_CONDITIONS",
        "BLOCKED_UNDEFINED_METRIC",
        "BLOCKED_UNSUPPORTED_CAUSALITY",
        "BLOCKED_DATA_QUALITY_RISK",
        "BLOCKED_PRIVACY_RISK",
        "BLOCKED_DASHBOARD_CONTRACT",
        "BLOCKED_UNTRACEABLE_INSIGHT",
        "RETURNED_MISSING_QUESTION",
        "RETURNED_MISSING_DATA_CONTEXT",
        "RETURNED_FOR_SCOPING"
      ]
    },
    "artifact_set": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["artifact_name", "file_path", "status"],
        "properties": {
          "artifact_name": {
            "type": "string",
            "enum": [
              "Analysis_Brief.md",
              "Metric_Catalog.md",
              "Exploratory_Analysis_Report.md",
              "Insight_Report.md",
              "Dashboard_Spec.md"
            ]
          },
          "file_path": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["complete", "partial", "not_required"]
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "analysis_question": {
      "type": "object",
      "required": ["question", "decision_supported", "population", "time_window", "comparison"],
      "properties": {
        "question": { "type": "string" },
        "decision_supported": { "type": "string" },
        "population": { "type": "string" },
        "time_window": { "type": "string" },
        "comparison": { "type": "string" }
      },
      "additionalProperties": false
    },
    "metrics_covered": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["metric_id", "metric_name", "grain", "owner", "definition_status"],
        "properties": {
          "metric_id": { "type": "string", "pattern": "^MET-[0-9]{3,}$" },
          "metric_name": { "type": "string" },
          "grain": { "type": "string" },
          "owner": { "type": "string" },
          "definition_status": {
            "type": "string",
            "enum": ["complete", "partial", "blocked"]
          }
        },
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding_id", "summary", "confidence", "evidence_refs", "recommendation"],
        "properties": {
          "finding_id": { "type": "string", "pattern": "^FIND-[0-9]{3,}$" },
          "summary": { "type": "string" },
          "confidence": {
            "type": "string",
            "enum": ["high", "medium", "low", "insufficient_evidence"]
          },
          "evidence_refs": {
            "type": "array",
            "items": { "type": "string" }
          },
          "recommendation": { "type": "string" },
          "owner": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "confidence_summary": {
      "type": "object",
      "required": ["high", "medium", "low", "insufficient_evidence"],
      "properties": {
        "high": { "type": "integer", "minimum": 0 },
        "medium": { "type": "integer", "minimum": 0 },
        "low": { "type": "integer", "minimum": 0 },
        "insufficient_evidence": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "data_quality_status": {
      "type": "object",
      "required": ["status", "blocking_quality_issues"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["passed", "passed_with_caveats", "blocked", "not_evaluated"]
        },
        "blocking_quality_issues": { "type": "integer", "minimum": 0 },
        "summary": { "type": "string" }
      },
      "additionalProperties": false
    },
    "privacy_notes": {
      "type": "object",
      "required": ["personal_data_used", "privacy_status"],
      "properties": {
        "personal_data_used": { "type": "boolean" },
        "privacy_status": {
          "type": "string",
          "enum": ["not_applicable", "minimized", "requires_review", "blocked"]
        },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "blocking_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["block_code", "description", "resolution_required"],
        "properties": {
          "block_code": { "type": "string" },
          "description": { "type": "string" },
          "resolution_required": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["question", "directed_to", "blocking"],
        "properties": {
          "question": { "type": "string" },
          "directed_to": {
            "type": "string",
            "enum": [
              "Agente00_TechLead",
              "Agente01_ProductOwner",
              "Agente05_DevFrontend",
              "Agente07_DevSecOps",
              "Agente10_DataIntegrationEngineer",
              "client"
            ]
          },
          "blocking": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["risk_id", "classification", "description", "mitigation", "blocks_gate"],
        "properties": {
          "risk_id": { "type": "string", "pattern": "^RISK-[0-9]{3,}$" },
          "classification": {
            "type": "string",
            "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
          },
          "description": { "type": "string" },
          "mitigation": { "type": "string" },
          "blocks_gate": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "required_next_agent": {
      "type": "string",
      "enum": [
        "Agente00_TechLead",
        "Agente01_ProductOwner",
        "Agente05_DevFrontend",
        "Agente06_QaEngineer",
        "Agente10_DataIntegrationEngineer"
      ]
    },
    "gate_ready": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
