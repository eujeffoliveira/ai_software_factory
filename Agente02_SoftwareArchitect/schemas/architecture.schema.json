{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Architecture Document Schema",
  "description": "Validates the Architecture.md structured metadata for Agente02_SoftwareArchitect output.",
  "type": "object",
  "required": ["project", "architecture_style", "components", "data_flows", "stack", "golden_path_status"],
  "properties": {
    "project": {
      "type": "object",
      "required": ["name", "prd_version", "architect_version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "prd_version": { "type": "string" },
        "architect_version": { "type": "string" },
        "date": { "type": "string", "format": "date" }
      }
    },
    "architecture_style": {
      "type": "string",
      "enum": ["fullstack-monorepo", "fullstack-monorepo-with-worker", "fullstack-monorepo-with-service", "custom-see-adr"],
      "description": "Primary architecture style"
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "type", "responsibility", "location"],
        "properties": {
          "name": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["proxy", "auth", "server-component", "client-component", "route-handler", "cron-route", "server-action", "dal", "job", "integration", "service", "external"]
          },
          "responsibility": { "type": "string" },
          "location": { "type": "string", "description": "File path or folder pattern" },
          "dependencies": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "data_flows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type", "steps"],
        "properties": {
          "name": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["stable-read", "polling-read", "mutation", "cron-job", "integration-sync"]
          },
          "steps": {
            "type": "array",
            "minItems": 2,
            "items": { "type": "string" }
          }
        }
      }
    },
    "stack": {
      "type": "object",
      "required": ["framework", "database", "auth", "deploy"],
      "properties": {
        "framework": { "type": "string" },
        "database": { "type": "string" },
        "orm": { "type": "string" },
        "auth": { "type": "string" },
        "deploy": { "type": "string" },
        "validation": { "type": "string" },
        "testing": {
          "type": "object",
          "properties": {
            "unit": { "type": "string" },
            "e2e": { "type": "string" }
          }
        },
        "additional_services": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["service", "purpose", "adr_id"],
            "properties": {
              "service": { "type": "string" },
              "purpose": { "type": "string" },
              "adr_id": { "type": "string" }
            }
          }
        }
      }
    },
    "golden_path_status": {
      "type": "string",
      "enum": ["FULLY_COMPLIANT", "COMPLIANT_WITH_ADRS", "NON_COMPLIANT_PENDING_ADRS"]
    },
    "adrs_required": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["adr_id", "reason", "status"],
        "properties": {
          "adr_id": { "type": "string" },
          "reason": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["PROPOSED", "APPROVED", "REQUIRED_NOT_YET_WRITTEN"]
          }
        }
      }
    },
    "prd_traceability": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["prd_requirement", "architectural_decision"],
        "properties": {
          "prd_requirement": { "type": "string" },
          "architectural_decision": { "type": "string" },
          "component": { "type": "string" }
        }
      }
    }
  }
}
