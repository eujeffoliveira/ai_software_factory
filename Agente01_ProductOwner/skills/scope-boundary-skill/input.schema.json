{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ScopeBoundaryInput",
  "description": "Input for the scope-boundary-skill",
  "type": "object",
  "required": ["business_problem", "objectives", "feature_requests"],
  "properties": {
    "business_problem": {
      "type": "string",
      "minLength": 20
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description"],
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "feature_requests": {
      "type": "array",
      "description": "All features discussed during elicitation, including those likely out-of-scope",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["feature_name", "description"],
        "properties": {
          "feature_name": { "type": "string" },
          "description": { "type": "string" },
          "stakeholder_priority": { "type": "string", "enum": ["must_have", "nice_to_have", "mentioned_only"] }
        }
      }
    },
    "constraints": {
      "type": "array",
      "description": "Known constraints driving scope exclusions",
      "items": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "enum": ["time", "budget", "regulatory", "dependency", "complexity"] },
          "description": { "type": "string" }
        }
      }
    }
  }
}
