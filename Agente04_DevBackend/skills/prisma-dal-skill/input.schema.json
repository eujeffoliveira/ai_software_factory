{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-software-factory/skills/prisma-dal-skill/input",
  "title": "prisma-dal-skill Input",
  "type": "object",
  "required": ["model_name", "operations", "file_path"],
  "properties": {
    "model_name": { "type": "string", "pattern": "^[A-Z][a-zA-Z0-9]+$" },
    "operations": {
      "type": "array",
      "items": { "type": "string", "enum": ["findUnique", "findMany", "create", "update", "delete", "upsert", "count", "transaction"] }
    },
    "file_path": { "type": "string", "pattern": "^lib/db/[a-z][a-zA-Z0-9]+\\.dal\\.ts$" }
  },
  "additionalProperties": false
}
