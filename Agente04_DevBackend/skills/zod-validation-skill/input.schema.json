{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-software-factory/skills/zod-validation-skill/input",
  "title": "zod-validation-skill Input",
  "type": "object",
  "required": ["entity_name", "fields"],
  "properties": {
    "entity_name": {
      "type": "string",
      "pattern": "^[A-Z][a-zA-Z0-9]+$",
      "examples": ["Task", "Project", "User"]
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string", "examples": ["string", "number", "boolean", "Date"] },
          "constraints": { "type": "string", "examples": [".min(1).max(255)", ".int().min(1).max(5)"] },
          "optional": { "type": "boolean", "default": false }
        },
        "additionalProperties": false
      }
    },
    "file_path": { "type": "string" }
  },
  "additionalProperties": false
}
