{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Privacy Review Skill Output",
  "type": "object",
  "required": ["overall_status", "legal_basis_status", "data_minimization_status", "consent_status", "deletion_status", "findings"],
  "properties": {
    "overall_status": { "type": "string", "enum": ["COMPLIANT", "NON_COMPLIANT", "PENDING_HUMAN", "NOT_APPLICABLE"] },
    "legal_basis_status": { "type": "string", "enum": ["PASS", "FAIL", "NOT_APPLICABLE"] },
    "data_minimization_status": { "type": "string", "enum": ["PASS", "FAIL"] },
    "consent_status": { "type": "string", "enum": ["PASS", "FAIL", "NOT_APPLICABLE"] },
    "deletion_status": { "type": "string", "enum": ["PASS", "FAIL", "NOT_APPLICABLE"] },
    "third_party_status": { "type": "string", "enum": ["PASS", "FAIL", "NOT_APPLICABLE"] },
    "human_escalation_required": { "type": "boolean" },
    "escalation_reason": { "type": "string" },
    "privacy_assessment_path": { "type": "string" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding_id", "severity", "description", "remediation"],
        "properties": {
          "finding_id": { "type": "string" },
          "severity": { "type": "string", "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"] },
          "description": { "type": "string" },
          "remediation": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
