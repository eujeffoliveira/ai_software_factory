{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Threat Modeling Skill Output",
  "type": "object",
  "required": ["threat_model_produced", "stride_coverage_complete", "open_threats_count", "findings_for_gate_5"],
  "properties": {
    "threat_model_produced": { "type": "boolean" },
    "threat_model_path": { "type": "string" },
    "stride_coverage_complete": { "type": "boolean" },
    "missing_categories": {
      "type": "array",
      "items": { "type": "string", "enum": ["S","T","R","I","D","E"] }
    },
    "open_threats_count": { "type": "integer", "minimum": 0 },
    "open_threats_critical_or_high": { "type": "integer", "minimum": 0 },
    "findings_for_gate_5": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding_id", "severity", "description", "decision_rule"],
        "properties": {
          "finding_id": { "type": "string" },
          "severity": { "type": "string", "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"] },
          "description": { "type": "string" },
          "decision_rule": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "blocked_pending_human": { "type": "boolean" },
    "block_reason": { "type": "string" }
  },
  "additionalProperties": false
}
