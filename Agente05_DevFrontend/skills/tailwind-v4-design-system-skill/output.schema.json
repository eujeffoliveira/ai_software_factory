{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "TailwindDesignSystemOutput",
  "type": "object",
  "required": ["design_token_compliant", "violations_found", "violations_fixed"],
  "properties": {
    "design_token_compliant": { "type": "boolean" },
    "violations_found": { "type": "integer", "minimum": 0 },
    "violations_fixed": { "type": "integer", "minimum": 0 },
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "type", "original", "replacement"],
        "properties": {
          "file": { "type": "string" },
          "type": { "type": "string", "enum": ["inline_style", "hardcoded_color", "non_token_class"] },
          "original": { "type": "string" },
          "replacement": { "type": "string" },
          "fixed": { "type": "boolean" }
        }
      }
    }
  }
}
