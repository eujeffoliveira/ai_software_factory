{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "ServerComponentSelectionInput",
  "type": "object",
  "required": ["component_name", "component_requirements", "file_path"],
  "properties": {
    "component_name": { "type": "string", "pattern": "^[A-Z][a-zA-Z0-9]+$" },
    "component_requirements": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "uses_state": { "type": "boolean", "default": false },
    "uses_effects": { "type": "boolean", "default": false },
    "uses_event_handlers": { "type": "boolean", "default": false },
    "uses_browser_apis": { "type": "boolean", "default": false },
    "uses_recharts": { "type": "boolean", "default": false },
    "file_path": { "type": "string" }
  }
}
