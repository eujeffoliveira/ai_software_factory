{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "acceptance-criteria-validation-skill Input",
  "type": "object",
  "required": ["total_criteria", "criteria_list"],
  "properties": {
    "total_criteria": { "type": "integer", "minimum": 1 },
    "criteria_list": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["criterion_id", "given", "when", "then_clauses"],
        "properties": {
          "criterion_id": { "type": "string", "pattern": "^AC-[0-9]{3,}$" },
          "given": { "type": "string" },
          "when": { "type": "string" },
          "then_clauses": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
        }
      }
    }
  }
}
