{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "vitest-generation-skill Output",
  "type": "object",
  "required": ["test_file_path", "test_cases_count", "mocks_applied"],
  "properties": {
    "test_file_path": { "type": "string" },
    "test_cases_count": { "type": "integer", "minimum": 4 },
    "mocks_applied": { "type": "array", "items": { "type": "string" } },
    "acceptance_criteria_covered": { "type": "array", "items": { "type": "string" } }
  }
}
