{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "vitest-generation-skill Input",
  "type": "object",
  "required": ["function_name", "file_path", "mock_dependencies", "acceptance_criteria"],
  "properties": {
    "function_name": { "type": "string" },
    "file_path": { "type": "string" },
    "function_signature": { "type": "string" },
    "mock_dependencies": { "type": "array", "items": { "type": "string" } },
    "acceptance_criteria": { "type": "array", "items": { "type": "string", "pattern": "^AC-[0-9]{3,}$" } },
    "valid_input_example": { "type": "object" },
    "invalid_input_example": { "type": "object" }
  }
}
