{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "accessibility-regression-skill Output",
  "type": "object",
  "required": ["flows_tested", "flows_passed", "flows_failed", "violations"],
  "properties": {
    "flows_tested": { "type": "integer", "minimum": 0 },
    "flows_passed": { "type": "integer", "minimum": 0 },
    "flows_failed": { "type": "integer", "minimum": 0 },
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["flow", "check", "severity"],
        "properties": {
          "flow": { "type": "string" },
          "check": { "type": "string" },
          "severity": { "type": "string", "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"] },
          "description": { "type": "string" }
        }
      }
    }
  }
}
