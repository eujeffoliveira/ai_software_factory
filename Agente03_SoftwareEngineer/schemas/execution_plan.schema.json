{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-software-factory/agente03/schemas/execution-plan",
  "title": "Execution Plan Schema",
  "description": "Validates Execution_Plan.json produced by Agente03_SoftwareEngineer.",
  "type": "object",
  "required": [
    "plan_id",
    "version",
    "project",
    "created_at",
    "architecture_version",
    "prd_version",
    "tasks",
    "critical_path",
    "gate_status"
  ],
  "additionalProperties": false,
  "properties": {
    "plan_id": {
      "type": "string",
      "description": "Unique identifier for this execution plan.",
      "pattern": "^plan-[a-z0-9\\-]+$"
    },
    "version": {
      "type": "string",
      "description": "Plan version. Start at '1.0', increment on revision.",
      "examples": ["1.0", "1.1", "2.0"]
    },
    "project": {
      "type": "string",
      "description": "Human-readable project name.",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "description": "ISO 8601 timestamp of plan creation.",
      "format": "date-time"
    },
    "architecture_version": {
      "type": "string",
      "description": "Version of Architecture.md this plan was generated from.",
      "minLength": 1
    },
    "prd_version": {
      "type": "string",
      "description": "Version of PRD.md this plan was generated from.",
      "minLength": 1
    },
    "tasks": {
      "type": "array",
      "description": "Ordered array of atomic tasks. Must contain at least 1 task.",
      "minItems": 1,
      "items": {
        "$ref": "task.schema.json"
      }
    },
    "critical_path": {
      "type": "array",
      "description": "Ordered list of task IDs forming the critical path (longest dependency chain).",
      "items": {
        "type": "string",
        "pattern": "^TASK-\\d{3}$"
      },
      "minItems": 1
    },
    "parallel_tracks": {
      "type": "array",
      "description": "Groups of task ID arrays that can be executed concurrently.",
      "items": {
        "type": "array",
        "description": "A parallel track: tasks with no mutual transitive dependencies.",
        "items": {
          "type": "string",
          "pattern": "^TASK-\\d{3}$"
        },
        "minItems": 2
      }
    },
    "total_complexity_estimate": {
      "type": "string",
      "description": "Overall complexity grade for the full plan.",
      "enum": ["S", "M", "L"]
    },
    "notes": {
      "type": "string",
      "description": "Optional human-readable notes about the plan for Tech Lead review."
    },
    "gate_status": {
      "type": "string",
      "description": "Current Gate 3 status code.",
      "enum": [
        "APPROVED",
        "RETURNED_FOR_REVISION",
        "BLOCKED_MISSING_ARTIFACT",
        "BLOCKED_PENDING_HUMAN",
        "BLOCKED_SCOPE_EXCEEDED",
        "BLOCKED_AMBIGUOUS_DEPENDENCY"
      ]
    }
  }
}
