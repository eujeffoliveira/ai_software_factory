{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-software-factory/agente03/skills/task-sizing/input",
  "title": "Task Sizing Skill — Input Schema",
  "type": "object",
  "required": ["tasks"],
  "additionalProperties": false,
  "properties": {
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["task_id", "title", "type", "file_path"],
        "properties": {
          "task_id": { "type": "string", "pattern": "^TASK-\\d{3}$" },
          "title": { "type": "string" },
          "type": { "type": "string" },
          "file_path": { "type": "string" },
          "function_signatures": { "type": "array", "items": { "type": "string" } },
          "depends_on": { "type": "array", "items": { "type": "string" } },
          "description": { "type": "string" }
        }
      }
    }
  }
}
