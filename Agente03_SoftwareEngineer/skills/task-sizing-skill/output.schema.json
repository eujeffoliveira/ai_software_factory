{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-software-factory/agente03/skills/task-sizing/output",
  "title": "Task Sizing Skill — Output Schema",
  "type": "object",
  "required": ["tasks", "total_plan_complexity", "xl_tasks_count"],
  "additionalProperties": false,
  "properties": {
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["task_id", "estimated_complexity", "context_window_risk"],
        "properties": {
          "task_id": { "type": "string", "pattern": "^TASK-\\d{3}$" },
          "estimated_complexity": { "type": "string", "enum": ["S", "M", "L", "XL"] },
          "estimated_loc": { "type": "integer", "description": "Estimated lines of code equivalent." },
          "context_window_risk": {
            "type": "string",
            "enum": ["none", "low", "medium", "high", "critical"]
          },
          "sizing_rationale": { "type": "string", "description": "Why this complexity was assigned." },
          "split_recommendation": {
            "type": "string",
            "description": "For XL tasks: how to split into smaller tasks."
          }
        }
      }
    },
    "total_plan_complexity": {
      "type": "string",
      "description": "Aggregate complexity grade for the full plan.",
      "enum": ["S", "M", "L"]
    },
    "xl_tasks_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of XL tasks. Must be 0 for Gate 3 to pass."
    },
    "l_tasks_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of L tasks. Each should have context_summary added."
    },
    "warnings": {
      "type": "array",
      "description": "Warnings for L and XL tasks.",
      "items": {
        "type": "object",
        "required": ["task_id", "severity", "message"],
        "properties": {
          "task_id": { "type": "string", "pattern": "^TASK-\\d{3}$" },
          "severity": { "type": "string", "enum": ["BLOCKING", "WARNING"] },
          "message": { "type": "string" },
          "mitigation": { "type": "string" }
        }
      }
    }
  }
}
