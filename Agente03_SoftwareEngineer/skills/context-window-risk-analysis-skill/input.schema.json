{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-software-factory/agente03/skills/context-window-risk-analysis/input",
  "title": "Context Window Risk Analysis Skill — Input Schema",
  "type": "object",
  "required": ["execution_plan"],
  "additionalProperties": false,
  "properties": {
    "execution_plan": {
      "type": "object",
      "description": "Full Execution_Plan.json object to analyze.",
      "required": ["plan_id", "tasks"],
      "properties": {
        "plan_id": { "type": "string" },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["task_id", "estimated_complexity"],
            "properties": {
              "task_id": { "type": "string" },
              "title": { "type": "string" },
              "type": { "type": "string" },
              "file_path": { "type": ["string", "null"] },
              "function_signatures": { "type": "array" },
              "depends_on": { "type": "array" },
              "estimated_complexity": { "type": "string", "enum": ["S", "M", "L", "XL"] },
              "context_summary": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
