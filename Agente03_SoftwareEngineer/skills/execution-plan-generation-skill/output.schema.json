{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-software-factory/agente03/skills/execution-plan-generation/output",
  "title": "Execution Plan Generation Skill — Output Schema",
  "type": "object",
  "required": ["plan_id", "tasks", "critical_path", "gate_ready"],
  "additionalProperties": false,
  "properties": {
    "plan_id": {
      "type": "string",
      "description": "Unique identifier for the generated plan.",
      "pattern": "^plan-[a-z0-9\\-]+$"
    },
    "tasks": {
      "type": "array",
      "description": "All atomic tasks in the execution plan.",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["task_id", "file_path", "acceptance_criteria", "test_requirements", "security_requirements", "estimated_complexity"],
        "properties": {
          "task_id": { "type": "string", "pattern": "^TASK-\\d{3}$" },
          "title": { "type": "string" },
          "type": { "type": "string" },
          "file_path": { "type": "string", "minLength": 5 },
          "depends_on": { "type": "array" },
          "acceptance_criteria": { "type": "array", "minItems": 1 },
          "test_requirements": { "type": "object" },
          "security_requirements": { "type": "object" },
          "estimated_complexity": { "type": "string", "enum": ["S", "M", "L"] }
        }
      }
    },
    "critical_path": {
      "type": "array",
      "description": "Ordered task IDs forming the critical path.",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^TASK-\\d{3}$" }
    },
    "parallel_tracks": {
      "type": "array",
      "description": "Groups of tasks that can run concurrently.",
      "items": {
        "type": "array",
        "items": { "type": "string", "pattern": "^TASK-\\d{3}$" },
        "minItems": 2
      }
    },
    "gate_ready": {
      "type": "boolean",
      "description": "True if the plan passes all Gate 3 blocking conditions. False if any blocking condition exists."
    },
    "blocking_issues": {
      "type": "array",
      "description": "List of blocking issues found during plan generation. Must be empty when gate_ready is true.",
      "items": {
        "type": "object",
        "properties": {
          "issue_code": { "type": "string" },
          "description": { "type": "string" },
          "affected_task": { "type": "string" }
        }
      }
    }
  }
}
