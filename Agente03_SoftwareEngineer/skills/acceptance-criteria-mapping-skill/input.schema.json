{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-software-factory/agente03/skills/acceptance-criteria-mapping/input",
  "title": "Acceptance Criteria Mapping Skill — Input Schema",
  "type": "object",
  "required": ["prd_acceptance_criteria", "tasks"],
  "additionalProperties": false,
  "properties": {
    "prd_acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["criterion_id", "description"],
        "properties": {
          "criterion_id": { "type": "string", "description": "PRD acceptance criterion ID." },
          "description": { "type": "string", "description": "Human-readable criterion description." },
          "story_id": { "type": "string", "description": "User story this criterion belongs to." }
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["task_id", "title", "type"],
        "properties": {
          "task_id": { "type": "string", "pattern": "^TASK-\\d{3}$" },
          "title": { "type": "string" },
          "type": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    }
  }
}
