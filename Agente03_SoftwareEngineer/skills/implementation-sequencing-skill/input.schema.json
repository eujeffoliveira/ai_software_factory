{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-software-factory/agente03/skills/implementation-sequencing/input",
  "title": "Implementation Sequencing Skill — Input Schema",
  "type": "object",
  "required": ["topological_order", "parallel_tracks", "tasks"],
  "additionalProperties": false,
  "properties": {
    "topological_order": {
      "type": "array",
      "description": "Task IDs in topological order from dependency-graph-skill.",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^TASK-\\d{3}$" }
    },
    "parallel_tracks": {
      "type": "array",
      "description": "Groups of task IDs that can run concurrently.",
      "items": {
        "type": "array",
        "items": { "type": "string", "pattern": "^TASK-\\d{3}$" },
        "minItems": 2
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["task_id", "type", "estimated_complexity"],
        "properties": {
          "task_id": { "type": "string", "pattern": "^TASK-\\d{3}$" },
          "title": { "type": "string" },
          "type": { "type": "string", "enum": ["backend", "frontend", "database", "infrastructure", "testing", "security", "config"] },
          "estimated_complexity": { "type": "string", "enum": ["S", "M", "L"] },
          "depends_on": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
